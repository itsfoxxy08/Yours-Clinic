# ==========================================
# Yours-Clinic Environment Configuration
# ==========================================

# Supabase Project Credentials
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key-here

# Email Provider / Custom SMTP Configuration
# Configure your custom SMTP provider (Resend, Brevo, SendGrid, Mailgun, or AWS SES)
# Never expose secret production credentials in client-side code.
VITE_EMAIL_API_URL=https://api.resend.com/emails
VITE_EMAIL_API_KEY=re_your_api_key_here
